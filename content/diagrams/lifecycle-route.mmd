%% Description:
%% The 18-phase Engineering Lifecycle Playbook progression organized into three major stages:
%% Define (Phases 0-6), Build (Phases 7-12), and Ship (Phases 13-17).
%% Human quality gates enforce formal verification before transitions:
%% - Gate G1 (Scope locked) after Phase 3
%% - Gate G2 (Build complete) after Phase 8
%% - Gate G3 (Production readiness) after Phase 12
%% - Gate G4 (Deployment verified) after Phase 14

flowchart TD
    subgraph STAGE_DEFINE["1. DEFINE (Idea & Scoping)"]
        P0["Phase 0: Orientation"] --> P1["Phase 1: Idea validation"]
        P1 --> P2["Phase 2: Requirements"]
        P2 --> P3["Phase 3: MVP planning"]
        P3 --> G1{"Gate G1: Scope locked"}
        G1 --> P4["Phase 4: System architecture"]
        P4 --> P5["Phase 5: Database design"]
        P5 --> P6["Phase 6: API design"]
    end

    subgraph STAGE_BUILD["2. BUILD (Implementation & Hardening)"]
        P6 --> P7["Phase 7: Frontend"]
        P7 --> P8["Phase 8: Backend"]
        P8 --> G2{"Gate G2: Build complete"}
        G2 --> P9["Phase 9: Security"]
        P9 --> P10["Phase 10: Testing"]
        P10 --> P11["Phase 11: Code review"]
        P11 --> P12["Phase 12: Performance"]
        P12 --> G3{"Gate G3: Production readiness"}
    end

    subgraph STAGE_SHIP["3. SHIP (Release & Operations)"]
        G3 --> P13["Phase 13: CI/CD"]
        P13 --> P14["Phase 14: Deployment"]
        P14 --> G4{"Gate G4: Deployment verified"}
        G4 --> P15["Phase 15: Monitoring"]
        P15 --> P16["Phase 16: Maintenance"]
        P16 --> P17["Phase 17: Handover"]
    end

    classDef gate fill:#fff3cd,stroke:#d39e00,stroke-width:2px,color:#856404;
    classDef stage fill:#f8f9fa,stroke:#dee2e6,stroke-width:1px;
    class G1,G2,G3,G4 gate;
