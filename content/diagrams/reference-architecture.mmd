%% Description:
%% Comprehensive reference architecture for a full-stack production application.
%% Traces incoming user traffic through:
%% 1. Clients: Mobile Web, Desktop, External API Integrations
%% 2. Edge: CDN Caching, TLS 1.3 Termination, WAF Rate Limiting
%% 3. Web App: Next.js Server-Side Rendering & Client Shell
%% 4. API Service: Node.js / Express Stateless Controllers & Middleware
%% 5. Workers: Background Queue Consumer Daemons (BullMQ)
%% 6. Data Stores: PostgreSQL Relational Database, Redis Cache, S3 Object Storage
%% 7. Identity: External OpenID Connect (OIDC) JWT Token Provider
%% 8. Observability: OpenTelemetry Collector exporting Metrics, Logs, and Traces

flowchart TB
    subgraph CLIENTS["1. Clients & Consumers"]
        WEB_USER["Web & Mobile Browsers (390px - 1440px)"]
        API_CLIENT["Third-Party API Integrations"]
    end

    subgraph EDGE["2. Edge & Security Perimeter"]
        CDN["Cloud CDN / WAF Gateway<br/>(TLS 1.3, Rate Limiting, CSP)"]
    end

    subgraph APP_TIER["3. Application Tier"]
        WEB_APP["Web Frontend Application<br/>(apps/web: Next.js / React 19)"]
        API_GW["API Server<br/>(apps/api: Node.js / TypeScript)"]
        WORKER["Background Task Workers<br/>(BullMQ Job Processor)"]
    end

    subgraph DATA_TIER["4. Persistence & Storage Tier"]
        DB[(Primary Database<br/>PostgreSQL 16 Multi-AZ)]
        CACHE[(In-Memory Cache<br/>Redis 7 Cluster)]
        STORAGE[(Object Storage<br/>S3-Compatible Encrypted Bucket)]
    end

    subgraph SERVICES["5. Identity & Observability"]
        IDP["OIDC Identity Provider<br/>(Auth0 / Okta / Google)"]
        OTEL["OpenTelemetry Collector<br/>(Metrics, Logs, Traces)"]
    end

    %% Network flows
    WEB_USER -->|HTTPS| CDN
    API_CLIENT -->|HTTPS| CDN
    CDN -->|Routed UI Traffic| WEB_APP
    CDN -->|Routed API Traffic| API_GW
    WEB_APP -.->|Client-Side API Calls| API_GW

    API_GW -->|Token Verification| IDP
    API_GW -->|ACID Transactions| DB
    API_GW -->|Cache & Rate Limit| CACHE
    API_GW -->|Enqueue Tasks| CACHE
    CACHE -->|Dequeue Tasks| WORKER
    WORKER -->|Batch Updates| DB
    WORKER -->|Store Media/PDFs| STORAGE

    %% Telemetry flows
    WEB_APP -.->|Telemetry| OTEL
    API_GW -.->|Telemetry| OTEL
    WORKER -.->|Telemetry| OTEL

    classDef edge fill:#fef3c7,stroke:#d97706,stroke-width:1px;
    classDef app fill:#dbeafe,stroke:#2563eb,stroke-width:1px;
    classDef data fill:#d1fae5,stroke:#059669,stroke-width:1px;
    classDef ext fill:#f3e8ff,stroke:#9333ea,stroke-width:1px;
    class CDN edge;
    class WEB_APP,API_GW,WORKER app;
    class DB,CACHE,STORAGE data;
    class IDP,OTEL ext;
